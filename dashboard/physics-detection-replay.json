      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Alerts, with evidence",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efu5gaxjlm7eoe"
                      },
                      "spec": {
                        "dataset": "icsdash",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  round((a.ts_epoch - r.attack_onset_epoch)::numeric, 1) AS \"t+ onset (s)\",\r\n  a.stream AS \"stream\",\r\n  CASE WHEN a.rule = 'cusum_high' THEN 'flow ABOVE expected'\r\n       ELSE 'flow BELOW expected' END AS \"direction\",\r\n  round(a.value::numeric, 1) AS \"CUSUM\",\r\n  a.threshold AS \"threshold\",\r\n  round(p.valve::numeric, 1) AS \"valve %\",\r\n  round(p.flow::numeric, 1) AS \"measured\",\r\n  round(p.flow_expected::numeric, 1) AS \"expected\",\r\n  round(p.residual_sigma::numeric, 1) AS \"sigma\"\r\nFROM alerts a\r\nJOIN run_bounds b ON b.run_id = a.run_id\r\nLEFT JOIN process p ON p.run_id = a.run_id\r\n     AND p.stream = a.stream AND p.ts_epoch = a.ts_epoch\r\nLEFT JOIN runs r ON r.run_id = a.run_id\r\nWHERE a.run_id = '$run' \r\n     AND (r.attack_onset_epoch IS NULL OR a.ts_epoch >= r.attack_onset_epoch)\r\nORDER BY a.ts_epoch\r\nLIMIT 200;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
