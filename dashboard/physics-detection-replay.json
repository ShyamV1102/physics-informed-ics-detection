              "rawSql": "SELECT to_timestamp(r.attack_onset_epoch) AS time,\r\n       to_timestamp(COALESCE(r.attack_offset_epoch,\r\n                             (SELECT max(ts_epoch) FROM process p WHERE p.run_id = r.run_id))) AS timeend,\r\n       r.attack_type AS text\r\nFROM runs r\r\nWHERE r.run_id = '$run' AND r.attack_onset_epoch IS NOT NULL;",
